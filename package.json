{
  "name": "solana-authority-inspector",
  "version": "0.1.0",
  "description": "A read-only, local-first Solana token mint authority inspector.",
  "type": "module",
  "license": "MIT",
  "author": "Royal Pinto <royalpinto007@gmail.com>",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "demo": "npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "dev": "npm run build && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "package:check": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royalpinto007/solana-authority-inspector.git"
  },
  "homepage": "https://www.npmjs.com/package/solana-authority-inspector",
  "bugs": {
    "url": "https://github.com/royalpinto007/solana-authority-inspector/issues"
  },
  "keywords": [
    "solana",
    "token",
    "authority",
    "mint",
    "token-2022",
    "developer-tools",
    "local-first",
    "typescript",
    "cli",
    "spl-token"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "solana-authority-inspector": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/*.md",
    "docs/*.svg",
    "docs/screenshot.png",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ]
}
